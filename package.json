{
  "name": "yt-mp3",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Windows YouTube to MP3 converter",
  "author": "YT MP3",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run electron:build && concurrently --kill-others --success first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "preview:ui": "vite --host 127.0.0.1",
    "electron:build": "tsc -p electron/tsconfig.json && node scripts/electron-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build": "npm run typecheck && npm run electron:build && vite build",
    "test": "playwright test",
    "test:desktop": "node scripts/real-desktop.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "tools:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-tools.ps1",
    "predev": "node scripts/ensure-tools.mjs",
    "predist": "node scripts/ensure-tools.mjs",
    "test:backend": "npm run electron:build && node --test scripts/backend.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.3",
    "cross-env": "^7.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0"
  },
  "build": {
    "appId": "com.ytmp3.desktop",
    "productName": "YT MP3",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "executableName": "YT MP3"
    },
    "nsis": {
      "artifactName": "YT-MP3-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "YT MP3",
      "runAfterFinish": true,
      "include": "assets/installer.nsh"
    },
    "extraResources": [
      {
        "to": "bin",
        "from": "resources/bin"
      },
      {
        "to": "licenses",
        "from": "resources/licenses"
      }
    ]
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
